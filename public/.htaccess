# iTEDDA - Apache / LiteSpeed (cPanel) configuration
# Copied into build/ automatically by `npm run build`.
# Upload it to public_html together with the rest of build/.
# NOTE: if the site is hosted in a sub-folder, change "RewriteBase /" and the
# fallback target "/index.html" to match (e.g. /itedda/ and /itedda/index.html).

# ---- 1. Force HTTPS (enable only after SSL shows as active in cPanel) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- 2. Single-page-app fallback (refresh never gives a 404) ----
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ---- 3. MIME types for 3D models and Draco decoder ----
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json   .gltf
  AddType application/wasm  .wasm
  AddType application/javascript .js
</IfModule>

# ---- 4. Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/wasm
  AddOutputFilterByType DEFLATE model/gltf+json image/svg+xml
</IfModule>

# ---- 5. Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  # index.html must always be revalidated so new deploys show up
  <FilesMatch "index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
  # Hashed build files never change, so cache them for a year
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
